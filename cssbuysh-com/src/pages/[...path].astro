---
import Layout from '../components/Layout.astro';
import GuideCards from '../components/GuideCards.astro';
import Faq from '../components/Faq.astro';
import {content,ui,publishedLocales} from '../data/content.mjs';
import {localePath,categories,registerUrl} from '../data/config.mjs';
export function getStaticPaths(){return publishedLocales.flatMap(lang=>{const data=content(lang);return ['','spreadsheet/','finds/','guide/','shipping/','articles/','faq/','qc/','search/visual/','product/','about/','privacy/',...data.articles.map(a=>`articles/${a.slug}/`)].map(path=>({params:{path:localePath(lang,path).slice(1).replace(/\/$/,'')||undefined},props:{lang,path}}));});}
const {lang,path}=Astro.props,data=content(lang),t=ui(lang),href=(p='')=>localePath(lang,p),article=data.articles.find(a=>path===`articles/${a.slug}/`||(path==='guide/'&&a.slug==='cssbuy-spreadsheet-guide')||(path==='shipping/'&&a.slug==='cssbuy-shipping-cost'));
const type=path===''?'home':article?'article':path.split('/')[0];
const title=article?.title||({home:t.homeTitle,spreadsheet:t.shopTitle,articles:t.guidesPageTitle,finds:t.navFinds,faq:t.faqPageTitle,qc:t.qcTitle,search:t.visualTitle,product:t.productTitle,about:t.aboutTitle,privacy:t.privacyTitle})[type];
const description=article?.description||({home:t.heroIntro,spreadsheet:t.shopIntro,articles:t.guidesPageIntro,finds:t.latestIntro,faq:t.faqIntro,qc:t.qcIntro,search:t.visualIntro,product:t.purchaseNote,about:t.aboutBody,privacy:t.privacyBody})[type];
---
<Layout title={title} description={description} lang={lang} path={path} t={t} article={article}>
{type==='home'&&<>
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> CSSBUY SH / {t.eyebrow}</p><h1>CSSBuy<br/><em>{t.navShop}.</em></h1><p class="hero-intro">{t.heroIntro}</p><form class="search-form" action={href('spreadsheet/')}><span aria-hidden="true" class="search-icon">⌕</span><input type="search" name="q" placeholder={t.searchPlaceholder} aria-label={t.searchPlaceholder}/><button type="submit" aria-label={t.searchButton}>↗</button></form><div class="hero-tags"><a class="text-link" href={href('spreadsheet/')}>{t.viewAll} →</a><a href={href('search/visual/')}>{t.visualTitle} ↗</a></div><p class="hero-note">{t.preview} · USD</p></div><div class="hero-display"><div class="hero-display-heading"><span>{t.heroCollection}</span><span>01 / 03</span></div><div id="hero-products" aria-live="polite"><p class="loading">{t.loading}</p></div><div class="hero-display-bottom"><span>{t.heroCaption}</span><a href={href('finds/')} aria-label={t.navFinds}>↗</a></div></div></section>
<section class="category-section wrap"><div class="section-heading tight"><h2>{t.category}</h2><a href={href('spreadsheet/')} class="text-link">{t.all} ↗</a></div><div class="category-index">{categories.slice(1).map((c,i)=><a href={`${href('spreadsheet/')}?category=${c}`}><span>{String(i+1).padStart(2,'0')}</span><strong>{t[c]}</strong><b aria-hidden="true">↗</b></a>)}</div></section>
<section class="section wrap" data-catalog="home"><div class="section-heading"><div><p class="eyebrow">01 / {t.latestEyebrow}</p><h2>{t.latestTitle}</h2><p>{t.latestIntro}</p></div><a class="text-link" href={href('spreadsheet/')}>{t.viewAll} ↗</a></div><div class="product-grid" id="catalog-products" aria-live="polite"><p class="loading">{t.loading}</p></div><p class="price-note">{t.priceNote}</p></section>
<section class="process-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">02 / {t.processEyebrow}</p><h2>{t.processTitle}</h2></div><a class="text-link" href={href('guide/')}>{t.startGuide} ↗</a></div><div class="steps">{[1,2,3,4].map(n=><div><span class="step-number">0{n}</span><h3>{t[`step${n}`]}</h3><p>{t[`step${n}Body`]}</p></div>)}</div></div></section>
<section class="section wrap"><div class="section-heading"><div><p class="eyebrow">03 / {t.guidesEyebrow}</p><h2>{t.guidesTitle}</h2></div><a class="text-link" href={href('articles/')}>{t.allGuides} ↗</a></div><GuideCards articles={data.articles.slice(0,4)} lang={lang} t={t}/></section>
<section class="section faq-home wrap"><div><p class="eyebrow">04 / FAQ</p><h2>{t.faqTitle}</h2><p>{t.faqIntro}</p><a class="text-link" href={href('faq/')}>{t.allFaq} ↗</a></div><Faq faq={data.faq.slice(0,4)} sources={data.sources} t={t} lang={lang}/></section>
</>}
{type==='finds'&&<section class="wrap section" data-catalog="home"><div class="page-heading"><p class="eyebrow">CSSBUY SH / {t.navFinds}</p><h1>{t.latestTitle}</h1><p>{t.latestIntro}</p></div><div class="category-chips">{categories.map(c=><a class="chip" href={`${href('spreadsheet/')}?category=${c}`}>{t[c]}</a>)}</div><div class="product-grid" id="catalog-products" aria-live="polite"><p class="loading">{t.loading}</p></div><p class="price-note">{t.priceNote}</p><a class="button" href={href('spreadsheet/')}>{t.viewAll} ↗</a></section>}
{type==='spreadsheet'&&<section class="wrap section shop" data-catalog="full"><div class="page-heading"><p class="eyebrow">{t.shopEyebrow}</p><h1>{title}</h1><p>{description}</p></div><form class="catalog-controls" id="catalog-form" action={href('spreadsheet/')}><div class="search-form"><span class="search-icon" aria-hidden="true">⌕</span><input name="q" type="search" placeholder={t.searchPlaceholder} aria-label={t.searchPlaceholder}/><button aria-label={t.searchButton}>↗</button></div><label>{t.category}<select name="category">{categories.map(c=><option value={c}>{t[c]}</option>)}</select></label><label>{t.sort}<select name="sort">{['popular','latest','price-up','price-down'].map(s=><option value={s}>{t[s]}</option>)}</select></label></form><div class="category-chips">{categories.map(c=><a class="chip" href={`${href('spreadsheet/')}?category=${c}`}>{t[c]}</a>)}</div><div class="catalog-status" id="catalog-status"></div><div class="product-grid" id="catalog-products" aria-live="polite"><p class="loading">{t.loading}</p></div><div class="pagination" id="catalog-pagination"></div><p class="price-note">{t.priceNote}</p></section>}
{type==='articles'&&<section class="wrap section"><div class="page-heading"><p class="eyebrow">{t.guidesEyebrow}</p><h1>{title}</h1><p>{description}</p></div><GuideCards articles={data.articles} lang={lang} t={t}/></section>}
{type==='faq'&&<section class="wrap section faq-page"><div class="page-heading"><p class="eyebrow">{t.faqPageEyebrow}</p><h1>{title}</h1><p>{description}</p></div><div class="faq-search"><span aria-hidden="true">⌕</span><input id="faq-search" type="search" aria-label={t.faqSearch} placeholder={t.faqSearch}/></div><p id="faq-no-results" hidden>{t.faqNoResults}</p><Faq faq={data.faq} sources={data.sources} t={t} lang={lang}/></section>}
{type==='article'&&<>
<section class="article-header wrap"><a class="back-link" href={href('articles/')}>← {t.backGuides}</a><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="article-description">{article.description}</p><div class="article-byline"><span>{t.editorialByline}</span><span>•</span><span>{t.reviewed}</span><span>•</span><span>{Math.max(4,Math.round(JSON.stringify(article).split(/\s+/).length/220))} {t.readTime}</span></div></section>
<div class="article-layout wrap"><aside class="article-toc"><span class="eyebrow">{t.inThisGuide}</span><ol>{article.sections.map((s,i)=><li><a href={`#section-${i}`}>{s.heading}</a></li>)}</ol><a class="button button-dark" href={href('spreadsheet/')}>{t.navShop} ↗</a></aside><article class="prose"><p class="article-intro">{article.intro}</p>{article.sections.map((s,i)=><section id={`section-${i}`}><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets?.length>0&&<ul>{s.bullets.map(b=><li>{b}</li>)}</ul>}</section>)}<section class="takeaways"><h2>{t.takeaways}</h2><ul>{article.takeaways.map(t=><li>{t}</li>)}</ul></section><section class="sources"><h2>{t.officialSources}</h2><p class="small">{t.guideEditorial}</p><ol>{article.sourceIds.map(id=>{const s=data.sources.find(s=>s.id===id);return s&&<li><a href={s.url.startsWith('/')?href(s.url.slice(1)):s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a></li>})}</ol></section></article></div>
<section class="wrap section"><div class="section-heading"><h2>{t.relatedGuides}</h2><a href={href('articles/')} class="text-link">{t.allGuides} ↗</a></div><GuideCards articles={data.articles.filter(a=>a.id!==article.id).slice(0,3)} lang={lang} t={t}/></section>
</>}
{type==='product'&&<section class="wrap section"><a class="back-link" href={href('spreadsheet/')}>← {t.backShop}</a><div id="product-detail" aria-live="polite"><p class="loading">{t.loading}</p></div></section>}
{type==='qc'&&<section class="wrap section narrow"><div class="page-heading"><p class="eyebrow">{t.qcEyebrow}</p><h1>{title}</h1><p>{description}</p></div><div class="note"><p>{t.qcPending}</p></div><a class="button button-dark" href={href('articles/cssbuy-qc-photos-guide/')}>{t.readQc} ↗</a><GuideCards articles={data.articles.filter(a=>['cssbuy-qc-photos-guide','cssbuy-size-guide'].includes(a.slug))} lang={lang} t={t} compact/></section>}
{type==='search'&&<section class="wrap section narrow"><div class="page-heading"><p class="eyebrow">{t.visualEyebrow}</p><h1>{title}</h1><p>{description}</p></div><a class="button button-dark" href={href('spreadsheet/')}>{t.browseInstead} ↗</a></section>}
{['about','privacy'].includes(type)&&<section class="wrap section narrow"><div class="page-heading"><h1>{title}</h1></div><div class="prose"><p>{description}</p></div></section>}
</Layout>
