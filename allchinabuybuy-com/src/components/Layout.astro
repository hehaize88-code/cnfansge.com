---
import {languages,ui,href} from '../data/ui.mjs';
import '../styles/global.css';
const {lang='en',path='',title,description}=Astro.props;const t=ui[lang];
const origin=process.env.SITE_ORIGIN||'https://allchinabuybuy.com';
const links=['spreadsheet','finds','guide','qc','shipping','faq','articles'];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | AllChinaBuyBuy</title><meta name="description" content={description}/><meta name="robots" content={process.env.SITE_INDEXABLE==='true'?'index,follow':'noindex,follow'}/><link rel="canonical" href={origin+href(lang,path)}/>{Object.keys(languages).map(l=><link rel="alternate" hreflang={l} href={origin+href(l,path)}/>)}<link rel="alternate" hreflang="x-default" href={origin+href('en',path)}/><link rel="icon" type="image/png" href="/brand/allchinabuy-user-logo.png"/><meta name="theme-color" content="#176c3a"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={path.startsWith('articles/')?'article':'website'}/><meta property="og:url" content={origin+href(lang,path)}/></head><body data-lang={lang}>
<a class="skip" href="#main">Skip to content</a>
<header class="header"><div class="header-inner"><a class="brand" href={href(lang)} aria-label="AllChinaBuyBuy home"><img src="/brand/allchinabuy-user-logo.png" width="186" height="27" alt="AllChinaBuy"/><span>SPREADSHEET & FINDS</span></a><nav aria-label="Primary">{links.map((p,i)=><a class:list={{active:path===p||p==='articles'&&path.startsWith('articles/')}} href={href(lang,p)}>{t.nav.split('|')[i]}</a>)}</nav><label class="language"><span aria-hidden="true">◎</span><select aria-label="Language" id="language">{Object.entries(languages).map(([l,label])=><option value={href(l,path)} selected={lang===l}>{label}</option>)}</select></label></div></header>
<div class="notice"><div class="wrap"><span class="dot"></span><span>{t.statusShort}</span><a href={href(lang,'status')}>{t.status} ↗</a></div></div>
<main id="main"><slot/></main>
<footer><div class="wrap footer-top"><div><a class="brand" href={href(lang)}><img src="/brand/allchinabuy-user-logo.png" width="186" height="27" alt="AllChinaBuy"/><span>SPREADSHEET & FINDS</span></a><p>{t.tagline}</p><p class="disclosure">{t.independent}</p></div><div class="footer-links">{links.map((p,i)=><a href={href(lang,p)}>{t.nav.split('|')[i]}</a>)}<a href={href(lang,'status')}>{t.maintenance}</a></div></div><div class="wrap footer-bottom"><span>© 2026 allchinabuybuy.com{process.env.SITE_INDEXABLE!=='true' && ' · Preview'}</span><span>{t.checked}</span><a href="#">{t.goTop} ↑</a></div></footer>
<script type="application/json" id="ui-data" set:html={JSON.stringify(t).replaceAll('<','\\u003c')}/>
<script>import '../scripts/client.js';</script>
</body></html>
