---
import Layout from '../components/Layout.astro';
import {languages,ui,href,categoryIds} from '../data/ui.mjs';
import {seo,quickSlugs,featuredSlugs,relatedSlugs} from '../data/seo.mjs';
import articles from '../data/articles.json';
import faqs from '../data/editorial/faq.json';
import pages from '../data/editorial/pages.json';
export function getStaticPaths(){return Object.keys(languages).flatMap(lang=>['','spreadsheet','finds','guide','qc','shipping','faq','articles','status','product','search/visual',...articles[lang].map(a=>'articles/'+a.slug)].map(path=>({params:{path:(lang==='en'?'':lang+'/')+path||undefined},props:{lang,path}})));}
const {lang,path}=Astro.props;const t={...ui[lang],...seo[lang]},a=articles[lang],faq=faqs[lang];
const article=path.startsWith('articles/')?a.find(x=>path==='articles/'+x.slug):null;
const page=pages[lang][path];
const title=article?.title||page?.title||({'':t.homeTitle,spreadsheet:t.catalogTitle,finds:t.findsTitle,faq:'AllChinaBuy FAQ',articles:t.articlesTitle,product:t.product,'search/visual':t.visual})[path];
const description=article?.description||page?.description||(path==='articles'?t.articleIntro:path==='faq'?t.faqIntro:path==='finds'?t.findsDescription:path==='spreadsheet'?t.catalogDescription:t.heroIntro);
const mins=article?Math.max(5,Math.ceil(article.sections.flatMap(s=>s.paragraphs).join(' ').split(/\s+/).length/200)):0;
const headingId=i=>'section-'+i;
const featured=featuredSlugs.map(slug=>a.find(x=>x.slug===slug)).filter(Boolean);
const ordered=[...featured,...a.filter(x=>!featuredSlugs.includes(x.slug))];
const related=article?(relatedSlugs[article.slug]||[]).map(slug=>a.find(x=>x.slug===slug)).filter(Boolean):[];
const modified=article?.dateModified||'2026-10-24';
const articleDate=article?new Intl.DateTimeFormat(lang,{dateStyle:'medium',timeZone:'UTC'}).format(new Date(modified+'T12:00:00Z')):'';
const origin=process.env.SITE_ORIGIN||'https://allchinabuybuy.com';
---
<Layout lang={lang} path={path} title={title} description={description}>
{path===''&&<>
<section class="hero wrap"><div class="hero-copy"><div class="eyebrow"><span></span>{t.kicker}</div><h1>AllChinaBuy <span>Spreadsheet</span></h1><p class="hero-line">{t.heroLine}</p><p class="intro">{t.heroIntro}</p><form action={href(lang,'spreadsheet')} class="search-form"><span aria-hidden="true">⌕</span><input name="q" aria-label={t.search} placeholder={t.search}/><button type="submit">{t.searchBtn} <span>↗</span></button></form><div class="hero-links"><a class="button" href={href(lang,'spreadsheet')}>{t.browse} ↗</a><a href={href(lang,'guide')}>{t.nav.split('|')[2]} ↗</a></div></div><div class="hero-feature"><div class="feature-label"><span>{t.notebook}</span><span>01 / 03</span></div><h2>{t.guideTitle}</h2><div class="steps">{t.steps.split('|').map((s,i)=><a href={href(lang,['spreadsheet','qc','guide'][i])}><span class="step-num">0{i+1}</span><div><h3>{s}</h3><p>{t.stepText.split('|')[i]}</p></div><span>↗</span></a>)}</div><div class="feature-bottom"><span>ALLCHINABUYBUY.COM</span><span>↗</span></div></div></section>
<section class="category-strip wrap" aria-label={t.category}>{['all','shoes','hoodies-sweaters','jersey','jackets','accessories'].map(c=><a class:list={{selected:c==='all'}} href={href(lang,'spreadsheet')+'?category='+c}>{t.cats.split('|')[categoryIds.indexOf(c)]}<span>↗</span></a>)}</section>
<section class="section wrap"><div class="section-title"><div><span class="eyebrow">{t.spreadsheetLabel}</span><h2>{t.latest}</h2><p>{t.latestSub}</p></div><a class="text-link" href={href(lang,'spreadsheet')}>{t.viewAll} ↗</a></div><div id="catalog" data-limit="8" data-home="true" class="product-grid" aria-live="polite"><div class="loading-state">{t.loading}</div></div></section>
<section class="editorial-section"><div class="wrap"><div class="section-title"><div><span class="eyebrow">{t.readingRoom}</span><h2>{t.guideTitle}</h2><p>{t.guideSub}</p></div><a class="text-link" href={href(lang,'articles')}>{t.allArticles} ↗</a></div><div class="article-grid">{featured.map((x,i)=><a class="article-card" href={href(lang,'articles/'+x.slug)}><div class={'article-cover tone-'+i}><span>{t.fieldNotes}</span><b>0{i+1}</b><span>ALLCHINABUY / {t.categoryLabels[x.category]||t.readingRoom}</span></div><div class="article-card-body"><span class="eyebrow">{t.editorial}</span><h3>{x.title}</h3><p>{x.description}</p><span class="read-link">{t.read} ↗</span></div></a>)}</div></div></section>
<section class="section wrap faq-home"><div><span class="eyebrow">{t.goodToKnow}</span><h2>{t.faqTitle}</h2><p>{t.faqIntro}</p><a class="text-link" href={href(lang,'faq')}>{t.faqAll} ↗</a></div><div>{[faq[0],faq[8],faq[14],faq[22]].map(f=><details><summary>{f.q}<span>+</span></summary><p>{f.a}</p></details>)}</div></section>
</>}
{['spreadsheet','finds'].includes(path)&&<section class="wrap catalog-page"><div class="page-heading"><span class="eyebrow">{t.kicker}</span><h1>{title}</h1><p>{path==='finds'?t.findsDescription:t.catalogDescription}</p><div class="intent-links">{quickSlugs.map((slug,i)=><a href={href(lang,'articles/'+slug)}>{t.quickLabels.split('|')[i]} ↗</a>)}</div></div><form id="catalog-form" class="catalog-controls" action={href(lang,path)}><div class="search-form"><span aria-hidden="true">⌕</span><input name="q" aria-label={t.search} placeholder={t.search}/><button>{t.searchBtn} ↗</button></div><div class="filters"><label>{t.category}<select name="category">{categoryIds.map((c,i)=><option value={c}>{t.cats.split('|')[i]}</option>)}</select></label><label>{t.sort}<select name="sort">{['popular','latest','price-up','price-down'].map((s,i)=><option value={s} selected={path==='finds'&&s==='latest'}>{t.sorts.split('|')[i]}</option>)}</select></label></div></form><div class="results-bar"><span id="results-label">{t.page} 1</span><span>{t.estimate}</span></div><div id="catalog" class="product-grid" data-sort={path==='finds'?'latest':'popular'} aria-live="polite"><div class="loading-state">{t.loading}</div></div><nav id="pagination" class="pagination" aria-label={t.pagination}></nav><div class="inline-note"><a href={href(lang,'search/visual')}>{t.visual} ↗</a><span>{t.sellerNote}</span></div></section>}
{path==='articles'&&<section class="wrap section"><div class="page-heading"><span class="eyebrow">{t.readingRoom}</span><h1>{title}</h1><p>{t.articleIntro}</p></div><div class="article-list">{ordered.map((x,i)=><a class="article-row" href={href(lang,'articles/'+x.slug)}><span class="article-number">{String(i+1).padStart(2,'0')}</span><div><span class="eyebrow">{t.editorial} · {Math.ceil(x.sections.flatMap(s=>s.paragraphs).join(' ').split(/\s+/).length/200)} {t.min}</span><h2>{x.title}</h2><p>{x.description}</p></div><span class="row-arrow">↗</span></a>)}</div></section>}
{article&&<><section class="article-heading wrap"><a class="breadcrumb" href={href(lang,'articles')}>← {t.nav.split('|')[6]}</a><span class="eyebrow">{t.editorial} · {mins} {t.min}</span><h1>{article.title}</h1><p>{article.description}</p><div class="article-meta"><span>AllChinaBuyBuy</span><time datetime={modified}>{t.updated} {articleDate}</time></div></section><div class="article-layout wrap"><aside class="toc"><p>{t.contents}</p>{article.sections.map((s,i)=><a href={'#'+headingId(i)}>{s.heading}</a>)}</aside><article class="prose"><div class="article-action"><strong>{t.nextStep}</strong><p>{t.nextStepText}</p><a class="button" href={href(lang,'spreadsheet')+(article.slug==='allchinabuy-shoes-spreadsheet'?'?category=shoes':'')}>{t.browse} ↗</a></div>{article.sections.map((s,i)=><section id={headingId(i)}><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets&&<ul>{s.bullets.map(b=><li>{b}</li>)}</ul>}</section>)}<section class="sources"><h2>{t.sources}</h2><ul>{article.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a></li>)}</ul><p>{t.checked}. {t.independent}</p></section><section class="related-guides"><h2>{t.related}</h2><ul>{related.map(x=><li><a href={href(lang,'articles/'+x.slug)}>{x.title}</a></li>)}</ul></section><a class="button" href={href(lang,'spreadsheet')}>{t.browse} ↗</a></article></div><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,inLanguage:lang,datePublished:article.datePublished||'2026-10-24',dateModified:modified,url:origin+href(lang,path),mainEntityOfPage:origin+href(lang,path),publisher:{'@type':'Organization',name:'AllChinaBuyBuy'},author:{'@type':'Organization',name:'AllChinaBuyBuy'}}).replaceAll('<','\\u003c')}/></>}
{path==='faq'&&<section class="wrap section faq-page"><div class="page-heading"><span class="eyebrow">{t.goodToKnow}</span><h1>AllChinaBuy FAQ</h1><p>{t.faqIntro}</p></div><div class="faq-filters">{['all','browsing','images','costs','official'].map((g,i)=><button data-faq-filter={g} class:list={{selected:i===0}}>{t.groups.split('|')[i]}</button>)}</div><div class="faq-list">{faq.map((f,i)=><details data-faq-group={f.group}><summary><span class="faq-index">{String(i+1).padStart(2,'0')}</span>{f.q}<span class="plus">+</span></summary><p>{f.a}</p></details>)}</div><div class="inline-note"><span>{t.checked}</span><a href="https://www.allchinabuy.com/" target="_blank" rel="noopener noreferrer">{t.official}</a></div></section>}
{page&&<section class="wrap section"><div class="page-heading"><span class="eyebrow">AllChinaBuy · {t.fieldNotes}</span><h1>{page.title}</h1><p>{page.description}</p></div><div class="guide-layout"><article class="prose">{page.sections.map(s=><section><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}{path==='status'&&<div class="status-box"><h2>{t.maintenance}</h2><p>{t.regNote}</p><a class="button" href="https://www.allchinabuy.com/" target="_blank" rel="noopener noreferrer">{t.official}</a></div>}</article><aside class="guide-aside"><span class="eyebrow">{t.continueExploring}</span>{['spreadsheet','articles','faq'].map((p,i)=><a href={href(lang,p)}>{[t.browse,t.allArticles,t.faqAll][i]} ↗</a>)}<small>{t.checked}</small></aside></div></section>}
{path==='search/visual'&&<section class="wrap section narrow"><div class="page-heading"><span class="eyebrow">{t.finderLabel}</span><h1>{t.visual}</h1><p>{t.visualNote}</p></div><form class="search-form" action={href(lang,'spreadsheet')}><input name="q" aria-label={t.search} placeholder={t.search}/><button>{t.searchBtn} ↗</button></form><a class="text-link" href={href(lang,'spreadsheet')}>{t.browse} ↗</a></section>}
{path==='product'&&<section class="wrap section"><a class="breadcrumb" href={href(lang,'spreadsheet')}>← {t.browse}</a><div id="product" aria-live="polite"><div class="loading-state">{t.loading}</div></div></section>}
</Layout>
