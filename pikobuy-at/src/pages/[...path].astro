---
import '../styles/global.css';
import { locales, t, categoryKeys, categorySlugs } from '../lib/i18n';
export function getStaticPaths(){return locales.flatMap(([locale])=>['','spreadsheet','product','guide','visual'].map(page=>({params:{path:[locale==='en'?'':locale,page].filter(Boolean).join('/')||undefined},props:{locale,page}})));}
const {locale,page}=Astro.props;
const text=t(locale),base=locale==='en'?'/':`/${locale}/`,href=(p='')=>`${base}${p?`${p}/`:''}`;
const registration='https://www.pikobuy.com/?mode=register&redirect=/home';
const title=page==='guide'?`${text.guide} — Pikobuy`:page==='visual'?`${text.visual} — Pikobuy`:`Pikobuy Spreadsheet — ${text.discover}`;
const origin='https://pikobuy-at-preview.hehaize88.chatgpt.site';
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title><meta name="description" content={text.intro}/><meta name="robots" content="noindex,nofollow"/>
<link rel="icon" type="image/png" href="/favicon.png"/><meta name="theme-color" content="#f8f8f3"/>
<link rel="canonical" href={`${origin}${href(page)}`}/>
{locales.map(([l])=><link rel="alternate" hreflang={l} href={`${origin}${l==='en'?'/':`/${l}/`}${page?`${page}/`:''}`}/>)}
<meta property="og:title" content={title}/><meta property="og:description" content={text.intro}/><meta property="og:type" content="website"/>
<meta property="og:url" content={`${origin}${href(page)}`}/>
</head>
<body data-page={page} data-locale={locale} data-base={base}>
<a class="skip" href="#main">↓ {text.catalog}</a>
<header class="header"><div class="header-inner">
<a class="brand" href={base} aria-label="Pikobuy.at"><img src="/pikobuy-logo.png" alt="Pikobuy" width="153" height="36"/><span>.AT</span></a>
<nav class="main-nav"><a class:list={[{active:page==='spreadsheet'}]} href={href('spreadsheet')}>{text.catalog}</a><a class:list={[{active:page==='guide'}]} href={href('guide')}>{text.guide}</a></nav>
<div class="header-right"><label class="locale"><span aria-hidden="true">◎</span><select id="language" aria-label={text.language}>{locales.map(([l,n])=><option value={l} selected={locale===l}>{n}</option>)}</select></label><a class="join" href={registration} target="_blank" rel="noopener noreferrer">{text.register}<span aria-hidden="true">↗</span></a></div>
</div></header>
<main id="main">
{page===''&&<>
<section class="hero wrap"><div class="hero-copy"><div class="eyebrow"><span class="dot"></span> PIKOBUY SPREADSHEET</div><h1>{text.headline}</h1><p>{text.intro}</p><form class="search hero-search" action={href('spreadsheet')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input name="q" aria-label={text.search} placeholder={text.searchPlaceholder} maxlength="120"/><button type="submit">{text.search}<span aria-hidden="true">↗</span></button></form><div class="hero-tags">{[1,2,3,7].map(i=><a href={`${href('spreadsheet')}?category=${categorySlugs[i]}`}>{text[categoryKeys[i]]}<span>↗</span></a>)}</div></div><div class="hero-note"><span class="note-index">01 — 03</span><div class="note-art" aria-hidden="true"><svg viewBox="0 0 180 180"><path d="M60 52V42c0-39 60-39 60 0v10M42 52h96l13 108H29L42 52Z"/><path d="m68 96 14 15 31-32"/></svg><span class="note-sticker">PICK.<br/>CHECK.<br/>PIKOBUY.</span></div><p>{text.step1}<br/>{text.step2}<br/><strong>{text.step3} ↗</strong></p></div></section>
<section class="finds wrap" aria-labelledby="finds-title"><div class="section-head"><div><div class="eyebrow">PIKOBUY FINDS</div><h2 id="finds-title">{text.discover}</h2></div><a class="text-link" href={href('spreadsheet')}>{text.viewAll} <span>↗</span></a></div><div class="category-chips">{[0,1,2,3,4,5,7].map(i=><a href={`${href('spreadsheet')}?category=${categorySlugs[i]}`} class:list={[{selected:i===0}]}>{text[categoryKeys[i]]}</a>)}</div><div id="catalog-status" class="status" role="status">{text.loading}</div><div id="product-grid" class="product-grid home-grid"></div><div class="center-link"><a class="button dark" href={href('spreadsheet')}>{text.viewAll}<span>↗</span></a></div></section>
<section class="guide-strip wrap"><div><div class="eyebrow">PIKOBUY SPREADSHEET</div><h2>{text.guide}</h2><p>{text.guideText}</p><a class="text-link" href={href('guide')}>{text.guide} ↗</a></div><ol>{[1,2,3].map(i=><li><span>0{i}</span><h3>{text[`step${i}`]}</h3></li>)}</ol></section>
</>}
{page==='spreadsheet'&&<section class="catalog-page wrap"><div class="catalog-top"><div class="eyebrow">PIKOBUY SPREADSHEET</div><h1>{text.discover}</h1><form class="search catalog-search" action={href('spreadsheet')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input name="q" aria-label={text.search} placeholder={text.searchPlaceholder} maxlength="120"/><button type="submit">{text.search} ↗</button></form></div><div class="catalog-layout"><aside class="categories"><h2>{text.catalog}</h2><nav>{categorySlugs.map((slug,i)=><a data-category={slug} href={`${href('spreadsheet')}?category=${slug}`}><span class="category-dot" aria-hidden="true"></span>{text[categoryKeys[i]]}<span class="arrow">↗</span></a>)}</nav><a class="visual-link" href={href('visual')}><span aria-hidden="true">▧</span>{text.visual} ↗</a></aside><div class="catalog-results"><div class="result-bar"><h2 id="result-title">{text.all}</h2><label>{text.sort}<select id="sort" aria-label={text.sort}><option value="popular">{text.popular}</option><option value="latest">{text.latest}</option><option value="price-up">{text.priceUp}</option><option value="price-down">{text.priceDown}</option></select></label></div><div id="catalog-status" class="status" role="status">{text.loading}</div><div id="product-grid" class="product-grid"></div><nav class="pagination" id="pagination" aria-label={`${text.previous} / ${text.next}`} hidden><button id="previous">← {text.previous}</button><span id="page-number"></span><button id="next">{text.next} →</button></nav><p class="small-note">{text.priceNote}</p></div></div></section>}
{page==='product'&&<section class="product-page wrap"><a class="text-link" href={href('spreadsheet')}>← {text.back}</a><div id="catalog-status" class="status" role="status">{text.loading}</div><div id="product-detail"></div></section>}
{page==='guide'&&<section class="editorial wrap"><div class="eyebrow">PIKOBUY SPREADSHEET</div><h1>{text.guide}</h1><p class="lead">{text.guideText}</p><div class="steps">{[1,2,3].map(i=><article><span class="step-number">0{i}</span><h2>{text[`step${i}`]}</h2><p>{i===1?text.intro:i===2?text.photoNotice:text.priceNote}</p><a class="text-link" href={i===3?registration:href('spreadsheet')} target={i===3?'_blank':undefined} rel={i===3?'noopener noreferrer':undefined}>{i===3?text.register:text.viewAll} ↗</a></article>)}</div><div class="info-panel"><h2>{text.photos} & QC</h2><p>{text.photoNotice}</p><p>{text.visualNotice}</p></div></section>}
{page==='visual'&&<section class="editorial wrap compact"><div class="eyebrow">PIKOBUY SPREADSHEET</div><h1>{text.visual}</h1><div class="info-panel"><span class="visual-symbol" aria-hidden="true">▧</span><p class="lead">{text.visualNotice}</p><a class="button dark" href={href('spreadsheet')}>{text.viewAll} ↗</a></div></section>}
</main>
<footer><div class="footer-inner wrap"><div><a class="footer-brand" href={base}>PIKOBUY<span>.AT</span></a><p>{text.independent}</p></div><div class="footer-links"><a href={href('spreadsheet')}>{text.catalog}</a><a href={href('guide')}>{text.guide}</a><a href="https://cnfansge.com" target="_blank" rel="noopener noreferrer">cnfansge.com ↗</a></div></div><div class="footer-bottom wrap"><span>© 2026 PIKOBUY.AT</span><span>PREVIEW 01</span></div></footer>
<script id="translations" type="application/json" set:html={JSON.stringify(text).replace(/</g,'\\u003c')}></script>
<script>import '../lib/client';</script>
</body></html>
