---
import {discovery} from '../lib/discovery';
import {editorial,faqGroups,reviewedDate,sourceLabel,articleSlugs} from '../lib/editorial';
const {locale,page,home=false}=Astro.props;
const content=editorial(locale),l=content.labels;
const base=locale==='en'?'/':`/${locale}/`,href=(path='')=>`${base}${path?`${path}/`:''}`;
const articles=articleSlugs.map(slug=>content.articles.find(a=>a.slug===slug)!);
const article=articles.find(a=>`articles/${a.slug}`===page);
const checkedDate=article?.reviewedDate||reviewedDate;
const date=new Intl.DateTimeFormat(locale,{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${checkedDate}T12:00:00Z`));
---
{home&&<section class="learn-strip wrap"><div class="section-head"><div><div class="eyebrow">PIKOBUY / {l.articles}</div><h2>{l.articlesTitle}</h2></div><a class="text-link" href={href('articles')}>{l.allArticles} ↗</a></div><div class="article-grid home-articles">{['how-to-use-pikobuy','pikobuy-review','shipping-cost'].map(slug=>articles.find(a=>a.slug===slug)!).map((a,i)=><a class="article-card" href={href(`articles/${a.slug}`)}><div class="article-card-top"><span>{a.category}</span><span>0{i+1}</span></div><h3>{a.title}</h3><p>{a.description}</p><span class="text-link">{l.readArticle} <span aria-hidden="true">↗</span></span></a>)}</div><div class="faq-prompt"><div><h3>{l.faqTitle}</h3><p>{l.faqShort}</p></div><a class="button dark" href={href('faq')}>{l.faq} <span aria-hidden="true">↗</span></a></div></section>}
{page==='faq'&&<section class="editorial wrap faq-page"><div class="eyebrow">PIKOBUY / {l.faq}</div><h1>{l.faqTitle}</h1><p class="lead">{l.faqIntro}</p><p class="review-note">{l.checked} <time datetime={checkedDate}>{date}</time> · {content.faqs.length} {l.questions}</p><nav class="topic-tabs" aria-label={l.onThisPage}>{faqGroups.map(g=><a href={`#${g}`}>{content.groups[g]}</a>)}</nav><div class="faq-layout"><div class="faq-sections">{faqGroups.map(group=><section id={group} class="faq-group"><h2>{content.groups[group]}<span>{content.faqs.filter(f=>f.group===group).length}</span></h2>{content.faqs.filter(f=>f.group===group).map(f=><details class="faq-item" id={f.id}><summary>{f.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{f.a}</p><div class="source-links"><span>{l.officialSources}</span>{f.sources.map(url=><a href={url} target="_blank" rel="noopener noreferrer">{sourceLabel(url,discovery(locale).catalogueSource)} ↗</a>)}</div></div></details>)}</section>)}</div><aside class="editorial-aside"><h2>{l.needHelp}</h2><p>{l.helpText}</p><a class="button dark" href="https://www.pikobuy.com/contact" target="_blank" rel="noopener noreferrer">{l.officialSupport} ↗</a><a class="text-link" href={href('articles')}>{l.articles} ↗</a></aside></div></section>}
{page==='articles'&&<section class="editorial wrap articles-page"><div class="eyebrow">PIKOBUY / {l.articles}</div><h1>{l.articlesTitle}</h1><p class="lead">{l.articlesIntro}</p><p class="review-note">{l.checked} <time datetime={checkedDate}>{date}</time> · {l.editorialNote}</p><div class="article-grid">{articles.map((a,i)=><a class="article-card" href={href(`articles/${a.slug}`)}><div class="article-card-top"><span>{a.category}</span><span>{String(i+1).padStart(2,'0')}</span></div><h2>{a.title}</h2><p>{a.description}</p><span class="text-link">{l.readArticle} <span aria-hidden="true">↗</span></span></a>)}</div></section>}
{article&&<article class="editorial wrap article-page"><nav class="breadcrumbs" aria-label={l.breadcrumbs}><a href={href()}>{l.home}</a><span>/</span><a href={href('articles')}>{l.articles}</a><span>/</span><span>{article.category}</span></nav><header class="article-header"><div class="eyebrow">{article.eyebrow}</div><h1>{article.title}</h1><p class="lead">{article.description}</p><div class="review-note"><span>{l.editorialTeam}</span><span>·</span><span>{l.checked} <time datetime={checkedDate}>{date}</time></span></div></header>{locale!=='en'&&<p class="translation-note">{l.translationNote}</p>}<div class="article-layout"><div class="article-body"><div class="article-takeaway"><span class="eyebrow">{l.quickAnswer}</span><p>{article.summary}</p></div><details class="article-toc"><summary>{l.onThisPage}<span aria-hidden="true">⌄</span></summary><ol>{article.sections.map(s=><li><a href={`#${s.id}`}>{s.title}</a></li>)}</ol></details>{article.sections.map(s=><section id={s.id}><h2>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets&&<ul class="article-checklist">{s.bullets.map(b=><li>{b}</li>)}</ul>}</section>)}<section class="article-sources"><h2>{l.officialSources}</h2><p>{l.sourceNote}</p><ul>{article.sources.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer">{sourceLabel(url,discovery(locale).catalogueSource)} ↗</a></li>)}</ul></section><div class="article-next"><a class="button dark" href={href('spreadsheet')}>{l.browseFinds} ↗</a><a class="text-link" href={href('faq')}>{l.faq} ↗</a></div></div><aside class="editorial-aside related-articles"><h2>{l.related}</h2>{article.related.map(slug=>articles.find(a=>a.slug===slug)).filter(Boolean).map(a=><a class="related-link" href={href(`articles/${a!.slug}`)}>{a!.title}<span>↗</span></a>)}<p>{l.independentNote}</p></aside></div></article>}
