{
  "name": "pikobuy-at",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/clean.mjs && node --test tests/*.test.mjs && astro build && node scripts/build-worker.mjs",
    "build:production": "SITE_ORIGIN=https://pikobuy.at SITE_INDEXABLE=true npm run build",
    "check": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.1",
    "cheerio": "1.1.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.22.0"
  }
}
