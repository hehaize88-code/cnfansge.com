---
import {localePath} from '../data/config.mjs';
const {articles,lang,t,compact=false}=Astro.props;
---
<div class:list={['guide-grid',{'compact':compact}]}>{articles.map((a,i)=><a class="guide-card" href={localePath(lang,`guides/${a.slug}/`)}><div class="guide-art" aria-hidden="true"><span>{String(i+1).padStart(2,'0')}</span><div class="guide-lines"></div><b>↗</b></div><div class="guide-card-body"><span class="eyebrow">{a.category}</span><h3>{a.title}</h3><p>{a.description}</p><div class="guide-meta"><span>{Math.max(4,Math.round(JSON.stringify(a).split(/\s+/).length/220))} {t.readTime}</span><span>{t.readGuide} ↗</span></div></div></a>)}</div>
