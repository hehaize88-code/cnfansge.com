---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import {isIndexableRoute} from '../../worker/seo.mjs';
import {locales,prefix} from '../data/locales.mjs';
const {lang='en',route='',ui,title,description,article,faqs}=Astro.props;
const p=prefix(lang); const at=(path='')=>`${p}/${path?path+'/':''}`;
const canonical=`https://kakobuybuys.com${at(route)}`;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><Analytics/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content={isIndexableRoute(route)?'index,follow,max-image-preview:large':'noindex,follow'}/><meta name="description" content={description}/><meta name="theme-color" content="#f4f6f8"/><title>{title} | Kakobuy Buys</title><link rel="icon" href="/favicon.ico"/><link rel="canonical" href={canonical}/>{Object.keys(locales).map(l=><link rel="alternate" hreflang={l} href={`https://kakobuybuys.com${prefix(l)}/${route?route+'/':''}`}/>)}<link rel="alternate" hreflang="x-default" href={`https://kakobuybuys.com/${route?route+'/':''}`}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/>{article&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,inLanguage:lang,datePublished:'2026-10-24',dateModified:'2026-10-24',author:{'@type':'Organization',name:'Kakobuy Buys'},mainEntityOfPage:canonical}).replaceAll('<','\\u003c')}/>}{faqs&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',inLanguage:lang,mainEntity:faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))}).replaceAll('<','\\u003c')}/>}</head>
<body data-lang={lang} data-prefix={p} data-route={route}>
<aside class="site-rail">
  <a class="brand rail-brand" href={at()} aria-label="Kakobuy Buys"><img src="/logo.png" alt="Kakobuy" width="140" height="36"/><span>BUYS</span></a>
  <p class="rail-caption">{ui.siteLabel}</p>
  <nav class="desktop-nav" aria-label={ui.menu}>{Object.entries(ui.nav).map(([key,label],i)=><a href={at(key)} class:list={{active:route===key||route.startsWith(key+'/')||(!route&&key==='spreadsheet')}}><span class="nav-icon" aria-hidden="true">{['▦','◇','↗','⊙','⇢','?','≡'][i]}</span><span>{label}</span><span class="nav-arrow" aria-hidden="true">↗</span></a>)}</nav>
  <a class="rail-guide" href={at('guide')}><span class="rail-guide-icon" aria-hidden="true">↗</span><strong>{ui.heroGuide}</strong><span>{ui.readGuide} →</span></a>
  <a class="rail-about" href={at('about')}>{ui.about}<span>↗</span></a>
</aside>
<header class="site-header"><div class="header-inner">
  <a class="brand mobile-brand" href={at()} aria-label="Kakobuy Buys"><img src="/logo.png" alt="Kakobuy" width="140" height="36"/><span>BUYS</span></a>
  <div class="header-location"><a href={at()}>{ui.home}</a><span>/</span><span>{route?ui.nav[route.split('/')[0]]||title:ui.nav.spreadsheet}</span></div>
  <div class="header-actions"><details class="locale-menu"><summary aria-label={ui.language}><span aria-hidden="true">◎</span> {lang.toUpperCase()} <span class="chevron" aria-hidden="true">⌄</span></summary><div class="locale-panel">{Object.entries(locales).map(([l,label])=><a data-locale={l} href={`${prefix(l)}/${route?route+'/':''}`} lang={l} aria-current={l===lang?'true':undefined}>{label}<small>{l.toUpperCase()}</small></a>)}</div></details><a href="https://item2.kakobuy.com/register" class="button button-small register" rel="sponsored noopener" target="_blank">{ui.register}<span aria-hidden="true">↗</span></a></div>
</div><nav class="mobile-nav" aria-label={ui.menu}>{Object.entries(ui.nav).map(([key,label])=><a href={at(key)} class:list={{active:route===key||route.startsWith(key+'/')}}>{label}</a>)}</nav></header>
<main id="main"><slot/></main>
<footer><div class="footer-main"><div><a class="brand" href={at()}><img src="/logo.png" alt="Kakobuy" width="124" height="32"/><span>BUYS</span></a><p>{ui.footerIntro}</p></div><div class="footer-links">{['spreadsheet','guide','faq','articles'].map(k=><a href={at(k)}>{ui.nav[k]}</a>)}<a href={at('about')}>{ui.about}</a></div></div><div class="footer-bottom"><p>{ui.independent} {ui.affiliate}</p><span>© 2026 Kakobuy Buys</span></div></footer>
<script id="ui-data" type="application/json" set:html={JSON.stringify(ui).replaceAll('<','\\u003c')}/>
<script src="../scripts/client.js"></script>
</body></html>
