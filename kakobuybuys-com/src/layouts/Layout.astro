---
import '../styles/global.css';
import {locales,prefix} from '../data/locales.mjs';
const {lang='en',route='',ui,title,description,article,faqs}=Astro.props;
const p=prefix(lang); const at=(path='')=>`${p}/${path?path+'/':''}`;
const canonical=`https://kakobuybuys.com${at(route)}`;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content={description}/><meta name="theme-color" content="#f8f5f0"/><title>{title} | Kakobuy Buys</title><link rel="icon" href="/favicon.ico"/><link rel="canonical" href={canonical}/>{Object.keys(locales).map(l=><link rel="alternate" hreflang={l} href={`https://kakobuybuys.com${prefix(l)}/${route?route+'/':''}`}/>)}<link rel="alternate" hreflang="x-default" href={`https://kakobuybuys.com/${route?route+'/':''}`}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/>{article&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,inLanguage:lang,datePublished:'2026-10-24',dateModified:'2026-10-24',author:{'@type':'Organization',name:'Kakobuy Buys'},mainEntityOfPage:canonical}).replaceAll('<','\\u003c')}/>}{faqs&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',inLanguage:lang,mainEntity:faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))}).replaceAll('<','\\u003c')}/>}</head>
<body data-lang={lang} data-prefix={p} data-route={route}>
<header class="site-header"><div class="header-inner"><a class="brand" href={at()} aria-label="Kakobuy Buys"><img src="/logo.png" alt="Kakobuy" width="140" height="36"/><span>BUYS</span></a><nav class="desktop-nav" aria-label={ui.menu}>{Object.entries(ui.nav).map(([key,label])=><a href={at(key)} class:list={{active:route===key||route.startsWith(key+'/')}}>{label}</a>)}</nav><div class="header-actions"><details class="locale-menu"><summary aria-label={ui.language}><span>◎</span> {lang.toUpperCase()} <span class="chevron">⌄</span></summary><div class="locale-panel">{Object.entries(locales).map(([l,label])=><a data-locale={l} href={`${prefix(l)}/${route?route+'/':''}`} lang={l} aria-current={l===lang?'true':undefined}>{label}<small>{l.toUpperCase()}</small></a>)}</div></details><a href="https://item2.kakobuy.com/register" class="button button-small register" rel="sponsored noopener" target="_blank">{ui.register}<span>↗</span></a></div></div><nav class="mobile-nav" aria-label={ui.menu}>{Object.entries(ui.nav).map(([key,label])=><a href={at(key)} class:list={{active:route===key}}>{label}</a>)}</nav></header>
<main id="main"><slot/></main>
<footer><div class="footer-main"><div><a class="brand" href={at()}><img src="/logo.png" alt="Kakobuy" width="124" height="32"/><span>BUYS</span></a><p>{ui.footerIntro}</p></div><div class="footer-links">{['spreadsheet','guide','faq','articles'].map(k=><a href={at(k)}>{ui.nav[k]}</a>)}<a href={at('about')}>{ui.about}</a></div></div><div class="footer-bottom"><p>{ui.independent} {ui.affiliate}</p><span>© 2026 Kakobuy Buys</span></div></footer>
<script id="ui-data" type="application/json" set:html={JSON.stringify(ui).replaceAll('<','\\u003c')}/>
<script src="../scripts/client.js"></script>
</body></html>
