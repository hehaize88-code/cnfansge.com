---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ShippingCalculator from '../components/ShippingCalculator.astro';
import {locales,prefix,paths} from '../data/locales.mjs';
import fs from 'node:fs';
export function getStaticPaths(){const result=[];for(const lang of Object.keys(locales)){const file=`./src/data/content/${lang}.json`;const data=JSON.parse(fs.readFileSync(file,'utf8'));for(const route of [...paths,...data.articles.map(a=>'articles/'+a.slug)]){const p=[lang==='en'?'':lang,route].filter(Boolean).join('/');result.push({params:{path:p||undefined},props:{lang,route,data}})}}return result;}
const {lang,route,data}=Astro.props;const t=data.ui;const p=prefix(lang);const at=(path='')=>`${p}/${path?path+'/':''}`;const articles=data.articles;const article=articles.find(a=>route==='articles/'+a.slug);const isHome=!route;
const titles={'':t.heroTitle,spreadsheet:t.catalogSeoTitle,finds:t.nav.finds,guide:t.nav.guide,qc:t.nav.qc,shipping:t.shippingSeoTitle,faq:t.nav.faq,articles:t.nav.articles,product:t.viewProduct,'search/visual':t.visualTitle,about:t.aboutTitle};
const descriptions={'':t.heroIntro,spreadsheet:t.catalogIntro,finds:t.findsIntro,guide:t.guideIntro,qc:t.qcIntro,shipping:t.shippingIntro,faq:t.faqIntro,articles:t.journalIntro,product:t.catalogIntro,'search/visual':t.visualIntro,about:t.aboutIntro};
const featuredSlugs=['kakobuy-shipping-calculator','is-kakobuy-legit','kakobuy-shipping-time-tracking','kakobuy-returns-refunds'];
const featuredArticles=featuredSlugs.map(slug=>articles.find(a=>a.slug===slug)).filter(Boolean);
const orderedArticles=[...featuredArticles,...articles.filter(a=>!featuredSlugs.includes(a.slug))];
const relatedArticles=(article?.related||featuredSlugs).map(slug=>articles.find(a=>a.slug===slug)).filter(a=>a&&a.slug!==article?.slug).slice(0,3);
const categoryList=Object.keys(t.categories).filter(key=>key!=='all');
---
<Layout lang={lang} route={route} ui={t} title={article?.title||titles[route]} description={article?.description||descriptions[route]} article={article} faqs={route==='faq'?data.faqs:undefined}>
{isHome&&<>
<section class="home-intro shell"><div><p class="eyebrow"><span class="status-dot"></span>{t.catalogEyebrow}</p><h1>{t.heroTitle}</h1><p class="hero-accent">{t.heroAccent}</p></div><div class="intro-context"><p>{t.heroIntro}</p><div class="intro-links"><a href={at('articles')}><strong>{articles.length}</strong>{t.nav.articles}<span>↗</span></a><a href={at('faq')}><strong>{data.faqs.length}</strong>{t.nav.faq}<span>↗</span></a></div></div></section>
<div class="home-search shell"><form class="search-box" action={at('spreadsheet')}><span aria-hidden="true">⌕</span><input name="q" type="search" placeholder={t.searchPlaceholder} aria-label={t.search} maxlength="120" required/><button type="submit">{t.search}<span aria-hidden="true">↗</span></button></form><a class="image-search-link" href={at('search/visual')}><span aria-hidden="true">⊞</span>{t.imageSearch}<span aria-hidden="true">↗</span></a></div>
<section class="home-market shell"><aside class="market-categories"><p class="eyebrow">{t.category}</p><a class="all-categories" href={at('spreadsheet')}>{t.categories.all}<span>↗</span></a><div class="category-links">{categoryList.map(key=><a href={at('spreadsheet')+'?category='+key}>{t.categories[key]}<span aria-hidden="true">→</span></a>)}</div><div class="market-note"><span aria-hidden="true">ⓘ</span><p>{t.priceNote}</p></div></aside><div class="market-list"><div class="section-heading"><div><p class="eyebrow">{t.latestEyebrow}</p><h2>{t.latestTitle}</h2></div><a class="text-link" href={at('spreadsheet')}>{t.viewAll}<span>↗</span></a></div><div id="catalog-products" class="product-grid home-grid" data-catalog="home"><p class="loading">{t.loading}</p></div></div></section>
<section class="how-section shell"><div class="how-heading"><p class="eyebrow">{t.stepsEyebrow}</p><h2>{t.stepsTitle}</h2></div><div class="steps-grid">{t.steps.map((step,i)=><div><span class="step-number">{String(i+1).padStart(2,'0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></div>)}</div></section>
</>}
{(route==='spreadsheet'||route==='finds')&&<section class="shell page-section"><p class="eyebrow">{route==='finds'?t.findsEyebrow:t.catalogEyebrow}</p><h1 class="page-title">{route==='finds'?t.findsTitle:t.catalogTitle}</h1><p class="page-intro">{route==='finds'?t.findsIntro:t.catalogIntro}</p><form class="catalog-controls" action={at(route)}><label class="catalog-search"><span>{t.search}</span><input type="search" name="q" data-query="q" placeholder={t.searchPlaceholder} maxlength="120"/></label><label><span>{t.category}</span><select name="category" data-query="category">{Object.entries(t.categories).map(([value,label])=><option value={value}>{label}</option>)}</select></label><label><span>{t.sort}</span><select name="sort" data-query="sort">{Object.entries(t.sorts).map(([value,label])=><option value={value}>{label}</option>)}</select></label><button class="button" type="submit">{t.search} ↗</button></form><div class="catalog-meta"><span>{t.catalogStatus}</span><a href={at(route)}>{t.clearFilters}</a></div><div class="product-grid" id="catalog-products" data-catalog="full"><p class="loading">{t.loading}</p></div><div id="catalog-pagination"></div><p class="fineprint">{t.priceNote}</p></section>}
{route==='product'&&<section class="shell page-section"><a href={at('spreadsheet')} class="text-link">← {t.backCatalog}</a><div id="product-detail" class="product-detail"><p class="loading">{t.loading}</p></div></section>}
{route==='guide'&&<section class="shell page-section"><p class="eyebrow">{t.guideEyebrow}</p><h1 class="page-title">{t.guideTitle}</h1><p class="page-intro">{t.guideIntro}</p><div class="steps-grid guide-steps">{t.steps.map((step,i)=><div><span class="step-number">0{i+1}</span><h2>{step.title}</h2><p>{step.text}</p></div>)}</div></section>}
{route==='qc'&&<section class="shell page-section narrow"><p class="eyebrow">{t.qcEyebrow}</p><h1 class="page-title">{t.qcTitle}</h1><p class="page-intro">{t.qcIntro}</p><div class="notice">{t.qcUnavailable}</div><ul class="check-list">{t.qcChecklist.map(item=><li>{item}</li>)}</ul><a class="button" href={at('articles/kakobuy-qc-photos-guide')}>{t.readGuide} →</a></section>}
{route==='shipping'&&<section class="shell page-section"><p class="eyebrow">{t.shippingEyebrow}</p><h1 class="page-title">{t.shippingTitle}</h1><p class="page-intro">{t.shippingIntro}</p><div class="steps-grid guide-steps">{t.shippingCards.map((step,i)=><div><span class="step-number">0{i+1}</span><h2>{step.title}</h2><p>{step.text}</p></div>)}</div><a class="button" href={at('articles/kakobuy-shipping-costs')}>{t.readGuide} →</a></section>}
{route==='search/visual'&&<section class="shell page-section narrow"><p class="eyebrow">KAKOBUY BUYS</p><h1 class="page-title">{t.visualTitle}</h1><p class="page-intro">{t.visualIntro}</p><div class="notice">{t.visualUnavailable}</div><form class="search-box" action={at('spreadsheet')}><span>⌕</span><input name="q" type="search" placeholder={t.searchPlaceholder} aria-label={t.search} required/><button aria-label={t.search}>↗</button></form><a class="text-link" href={at('spreadsheet')}>{t.browse} →</a></section>}
{route==='about'&&<section class="shell page-section narrow"><p class="eyebrow">KAKOBUY BUYS</p><h1 class="page-title">{t.aboutTitle}</h1><p class="page-intro">{t.aboutIntro}</p><p class="body-copy">{t.aboutBody}</p></section>}
{(['spreadsheet','shipping','qc','faq'].includes(route))&&<section class="shell section decision-guides"><h2>{t.decisionGuides}</h2><div class="decision-links">{featuredArticles.map(a=><a href={at('articles/'+a.slug)}>{a.title}<span aria-hidden="true">→</span></a>)}</div></section>}
{(isHome||route==='articles'||route==='guide')&&<section class="shell section journal-section"><div class="section-heading"><div><p class="eyebrow">{t.journalEyebrow}</p>{route==='articles'?<h1 class="page-title">{t.journalTitle}</h1>:<h2>{t.journalTitle}</h2>}</div>{isHome&&<a class="text-link" href={at('articles')}>{t.allArticles} →</a>}</div><p class="section-intro">{t.journalIntro}</p><div class="article-grid">{(isHome?featuredArticles:orderedArticles).map((a,i)=><ArticleCard article={a} index={i} ui={t} href={at('articles/'+a.slug)}/>)}</div></section>}
{(isHome||route==='faq')&&<section class:list={['shell','section','faq-section',{'faq-full':route==='faq'}]}><div class="section-heading"><div><p class="eyebrow">{t.faqEyebrow}</p>{route==='faq'?<h1 class="page-title">{t.faqTitle}</h1>:<h2>{t.faqTitle}</h2>}</div>{isHome&&<a href={at('faq')} class="text-link">{t.faqLink} →</a>}</div><p class="section-intro">{t.faqIntro}</p><div class="faq-list">{(isHome?data.faqs.slice(0,4):data.faqs).map((f,i)=><details><summary><span class="faq-number">{String(i+1).padStart(2,'0')}</span>{f.question}<span class="faq-plus">+</span></summary><div class="faq-answer"><p>{f.answer}</p>{f.sources?.length>0&&<a class="source-link" href={f.sources[0]} target="_blank" rel="noopener noreferrer">{t.officialSources} ↗</a>}</div></details>)}</div></section>}
{article&&<article class="shell article-page"><a href={at('articles')} class="text-link">← {t.backArticles}</a><div class="article-header"><p class="eyebrow">{article.category} · {article.readMinutes} {t.minutes}</p><h1>{article.title}</h1><p class="article-description">{article.description}</p><p class="article-date">Kakobuy Buys · {t.reviewedLabel} <time datetime={article.dateModified}>{new Intl.DateTimeFormat(lang,{dateStyle:'long',timeZone:'UTC'}).format(new Date(article.dateModified+'T12:00:00Z'))}</time></p></div><div class="article-layout"><aside class="article-toc"><details open><summary>{t.contents}</summary><ol>{article.calculator&&<li><a href="#weight-calculator">{t.calculator.title}</a></li>}{article.sections.map((s,i)=><li><a href={'#'+(s.id||'section-'+i)}>{s.heading}</a></li>)}</ol></details></aside><div class="article-body">{article.answer&&<aside class="quick-answer" aria-label={t.quickAnswer}><strong>{t.quickAnswer}</strong><p>{article.answer}</p></aside>}<p class="article-lede">{article.intro}</p>{article.calculator&&<ShippingCalculator ui={t}/>}{article.sections.map((s,i)=><section id={s.id||'section-'+i}><h2>{s.heading}</h2>{s.paragraphs.map(text=><p>{text}</p>)}{s.table&&<div class="article-table" role="region" aria-label={s.heading} tabindex="0"><table><thead><tr>{s.table.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{s.table.rows.map(row=><tr>{row.map((cell,index)=>index===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div>}{s.bullets?.length>0&&<ul>{s.bullets.map(text=><li>{text}</li>)}</ul>}</section>)}<div class="source-box"><h2>{t.officialSources}</h2><p>{t.sourceNote}</p><ol>{article.sources.map((url,i)=><li><a href={url} target="_blank" rel="noopener noreferrer">Kakobuy · {i+1} ↗</a></li>)}</ol></div></div></div><div class="related-guides"><h2>{t.relatedTitle}</h2>{relatedArticles.map(a=><a href={at('articles/'+a.slug)}>{a.title}<span>→</span></a>)}</div><div class="article-catalog-link"><a class="button" href={at('spreadsheet')}>{t.browse} →</a></div></article>}
{(isHome||route==='articles')&&<section class="cta shell"><div><h2>{t.ctaTitle}</h2><p>{t.ctaBody}</p></div><a class="button" href={at('spreadsheet')}>{t.browse} ↗</a></section>}
</Layout>
