---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FaqItem from '../components/FaqItem.astro';
import {ui,locales,articles,faqs,path,signup,categoryKeys,articleOrder} from '../data/site';
export function getStaticPaths(){return locales.flatMap(lang=>['','spreadsheet','articles','faq','guide','qc','shipping','product',...articles(lang).map(a=>'articles/'+a.slug)].map(route=>({params:{path:((lang==='en'?'':lang+'/')+route)||undefined},props:{lang,route}})));}
const {lang,route}=Astro.props,t=ui(lang),all=articles(lang).sort((a,b)=>articleOrder.indexOf(a.slug)-articleOrder.indexOf(b.slug)),questions=faqs(lang);
const article=route.startsWith('articles/')?all.find(a=>'articles/'+a.slug===route):null;
const titles:Record<string,string>={'':t.heroTitle+' '+t.heroAccent,spreadsheet:t.catalogTitle,articles:t.articlesTitle,faq:t.faqTitle,guide:t.guideTitle,qc:t.qcTitle,shipping:t.shippingTitle,product:t.productImages};
const descriptions:Record<string,string>={'':t.heroDescription,spreadsheet:t.catalogDescription,articles:t.articlesIntro,faq:t.faqIntro,guide:t.guideIntro,qc:t.qcIntro,shipping:t.shippingIntro,product:t.buyNote};
const title=article?article.title+' | Superbuybuyss':(route==='spreadsheet'?'Superbuy Spreadsheet — ':'')+(titles[route]||t.heroTitle)+' | Superbuybuyss';
const description=article?.description||descriptions[route];
---
<Layout lang={lang} route={route} title={title} description={description} article={article}>
{route===''&&<>
<section class="hero container"><div class="hero-copy"><p class="eyebrow"><span class="blue-dot"></span>{t.heroEyebrow}</p><h1>{t.heroTitle}<br/><em>{t.heroAccent}</em></h1><p class="hero-description">{t.heroDescription}</p><form class="hero-search" action={path(lang,'spreadsheet')}><Icon name="search"/><input type="search" name="q" aria-label={t.searchPlaceholder} placeholder={t.searchPlaceholder}/><button aria-label={t.search}><Icon/></button></form><div class="hero-chips">{['shoes','hoodies-sweaters','t-shirts','accessories'].map(c=><a href={path(lang,'spreadsheet')+'?category='+c}>{t[c as keyof typeof t]}<span>↗</span></a>)}</div><a class="text-link hero-guide" href={path(lang,'guide')}><Icon name="book" size={18}/>{t.readGuide}<Icon size={16}/></a><p class="hero-note">{t.heroNote}</p></div><div class="hero-visual"><div class="collection-heading"><div><p class="eyebrow">{t.heroCollection}</p><h2>{t.heroCollectionTitle}</h2></div><span class="collection-symbol">↗</span></div><div id="hero-products" class="hero-products" aria-live="polite"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div><div class="collection-foot"><span>{t.heroImageNote}</span><a href={path(lang,'spreadsheet')}>{t.browseAll}<Icon size={16}/></a></div></div></section>
<div class="category-ribbon"><div class="container">{['shoes','hoodies-sweaters','jackets','pants-shorts','accessories','jersey'].map(c=><a href={path(lang,'spreadsheet')+'?category='+c}>{t[c as keyof typeof t]}<span>↗</span></a>)}</div></div>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">{t.findsEyebrow}</p><h2>{t.findsTitle}</h2><p>{t.findsDescription}</p></div><a class="text-link" href={path(lang,'spreadsheet')}>{t.seeAll}<Icon size={18}/></a></div><div id="home-products" class="product-grid" aria-live="polite">{Array.from({length:8},()=> <div class="skeleton product-skeleton"></div>)}</div><p class="caption">{t.priceNote}</p></section>
<section class="steps-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t.stepsEyebrow}</p><h2>{t.stepsTitle}</h2></div><p>{t.stepsDescription}</p></div><div class="steps-grid">{[1,2,3].map((n)=><div class="step"><div class="step-top"><span>0{n}</span><Icon name={['search','box','check'][n-1]} size={26}/></div><h3>{t[('step'+n+'Title') as keyof typeof t]}</h3><p>{t[('step'+n+'Text') as keyof typeof t]}</p></div>)}</div><a class="text-link" href={path(lang,'guide')}>{t.readGuide}<Icon size={16}/></a></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">{t.journalEyebrow}</p><h2>{t.journalTitle}</h2><p>{t.journalDescription}</p></div><a class="text-link" href={path(lang,'articles')}>{t.allArticles}<Icon size={18}/></a></div><div class="article-grid">{[0,3,4].map(i=><ArticleCard article={all[i]} index={i} lang={lang}/>)}</div></section>
<section class="faq-home section container"><div><p class="eyebrow">{t.faqEyebrow}</p><h2>{t.faqTitle}</h2><p>{t.faqIntro}</p><a class="text-link" href={path(lang,'faq')}>{t.allFaq}<Icon size={17}/></a></div><div>{[1,3,8,13,20].map((i,n)=><FaqItem faq={questions[i]} lang={lang} index={n}/>)}</div></section>
<section class="cta container"><div><p class="eyebrow">SUPERBUYBUYSS</p><h2>{t.ctaTitle}</h2><p>{t.ctaText}</p></div><a class="button white" href={path(lang,'spreadsheet')}>{t.browseAll}<Icon/></a></section>
</>}
{route==='spreadsheet'&&<section class="container catalog-section"><div class="page-heading"><p class="eyebrow">{t.catalogEyebrow}</p><h1>{t.catalogTitle}</h1><p>{t.catalogDescription}</p></div><form id="catalog-search" class="catalog-search"><Icon name="search"/><input name="q" type="search" placeholder={t.searchPlaceholder} aria-label={t.searchPlaceholder}/><button type="button" class="image-search-button" data-image-search aria-label={t.imageSearch} title={t.imageSearch}><Icon name="camera"/></button><button class="button" type="submit">{t.search}</button></form><div class="catalog-layout"><aside class="catalog-sidebar"><h2>{t.categories}</h2><div class="category-list">{categoryKeys.map(c=><a href={path(lang,'spreadsheet')+(c==='all'?'':'?category='+c)} data-category={c}>{t[c as keyof typeof t]}<Icon size={15}/></a>)}</div><div class="sidebar-note"><Icon name="book"/><h3>{t.navGuide}</h3><p>{t.quickCheckBody}</p><a class="text-link" href={path(lang,'guide')}>{t.readGuide}<Icon size={16}/></a></div></aside><div class="catalog-results"><div class="catalog-toolbar"><p id="result-count" role="status">{t.loading}</p><label>{t.sort}<select id="catalog-sort">{['popular','latest','price-up','price-down'].map(s=><option value={s}>{t[s as keyof typeof t]}</option>)}</select></label></div><p id="search-sort-note" class="caption" hidden>{t.searchSortNote} <a href={path(lang,'spreadsheet')}>{t.clearSearch}</a></p><div id="catalog-products" class="product-grid" aria-live="polite">{Array.from({length:8},()=> <div class="skeleton product-skeleton"></div>)}</div><div id="pagination" class="pagination" hidden><button id="previous" class="button outline">← {t.previous}</button><span id="page-number"></span><button id="next" class="button outline">{t.next} →</button></div><p class="caption">{t.priceNote}</p></div></div></section>}
{route==='articles'&&<section class="container section"><div class="page-heading"><p class="eyebrow">{t.articlesEyebrow}</p><h1>{t.articlesTitle}</h1><p>{t.articlesIntro}</p></div><div class="editorial-toolbar"><span class="editorial-label">10 <span>{t.navArticles}</span></span><label class="inline-search"><Icon name="search" size={18}/><input id="article-search" type="search" placeholder={t.articleSearch} aria-label={t.articleSearch}/></label></div><div class="article-grid article-index">{all.map((a,i)=><ArticleCard article={a} index={i} lang={lang}/>)}</div><p id="articles-empty" class="empty-state" hidden>{t.articlesEmpty}</p><p class="caption">{t.editorialNote}</p></section>}
{article&&<article class="container article-page"><a class="back-link" href={path(lang,'articles')}>← {t.backArticles}</a><div class="article-header"><p class="eyebrow">{article.category}</p><h1>{article.title}</h1><p class="article-description">{article.description}</p><div class="article-meta"><span>{t.updated}</span><span>{article.readMinutes} {t.minutes}</span><button id="copy-link"><Icon name="link" size={16}/><span>{t.copyLink}</span></button></div></div><div class="article-layout"><aside class="article-toc"><p class="eyebrow">{t.onThisPage}</p><ol>{article.sections.map((s,i)=><li><a href={'#section-'+(i+1)}>{s.heading}</a></li>)}</ol><a class="button" href={path(lang,'spreadsheet')}>{t.navCatalog}<Icon size={16}/></a></aside><div class="article-body"><div class="takeaways"><p class="eyebrow">{t.takeaways}</p><ul>{article.takeaways.map(text=><li><Icon name="check" size={17}/><span>{text}</span></li>)}</ul></div>{article.sections.map((s,i)=><section id={'section-'+(i+1)}><span class="section-number">{String(i+1).padStart(2,'0')}</span><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets?.length>0&&<ul>{s.bullets.map(p=><li>{p}</li>)}</ul>}</section>)}<div class="sources"><h2>{t.officialSources}</h2><p>{t.editorialNote}</p><ul>{article.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener">{s.label} ↗</a></li>)}</ul></div></div></div><div class="related-articles"><h2>{t.nextReading}</h2><div class="article-grid">{all.filter(a=>a.slug!==article.slug).slice(0,3).map((a,i)=><ArticleCard article={a} index={i} lang={lang}/>)}</div></div></article>}
{route==='faq'&&<section class="container section faq-page"><div class="page-heading"><p class="eyebrow">{t.faqEyebrow}</p><h1>{t.faqTitle}</h1><p>{t.faqIntro}</p></div><label class="inline-search faq-search"><Icon name="search"/><input id="faq-search" type="search" placeholder={t.faqSearch} aria-label={t.faqSearch}/></label><div class="faq-layout"><aside class="faq-nav">{[...new Set(questions.map(f=>f.category))].map((c,i)=><a href={'#faq-group-'+i}>{c}<span>↗</span></a>)}</aside><div class="faq-groups">{[...new Set(questions.map(f=>f.category))].map((c,i)=><section class="faq-group" id={'faq-group-'+i}><h2>{c}</h2>{questions.filter(f=>f.category===c).map(f=><FaqItem faq={f} lang={lang} index={questions.indexOf(f)}/>)}</section>)}<p id="faq-empty" class="empty-state" hidden>{t.faqNoMatch}</p></div></div></section>}
{route==='guide'&&<section class="container section"><div class="page-heading"><p class="eyebrow">{t.guideEyebrow}</p><h1>{t.guideTitle}</h1><p>{t.guideIntro}</p></div><div class="guide-steps">{[0,1,3,4].map((articleIndex,i)=><a class="guide-step" href={path(lang,'articles/'+all[articleIndex].slug)}><span class="guide-step-number">0{i+1}</span><div><p class="eyebrow">{t[('guideCard'+(i+1)) as keyof typeof t]}</p><h2>{all[articleIndex].title}</h2><p>{all[articleIndex].description}</p></div><Icon size={26}/></a>)}</div><div class="guide-bottom"><p>{t.editorialNote}</p><a class="button" href={signup} target="_blank" rel="noopener">{t.register}<Icon size={18}/></a></div></section>}
{route==='qc'&&<section class="container section"><div class="page-heading"><p class="eyebrow">{t.qcEyebrow}</p><h1>{t.qcTitle}</h1><p>{t.qcIntro}</p></div><div class="info-notice"><Icon name="camera" size={30}/><div><h2>{t.qcNoticeTitle}</h2><p>{t.qcNotice}</p></div></div><div class="steps-grid qc-steps">{[1,2,3].map(n=><div class="step"><div class="step-top"><span>0{n}</span><Icon name="check" size={24}/></div><h2>{t[('qcCheck'+n) as keyof typeof t]}</h2><p>{t[('qcCheck'+n+'Text') as keyof typeof t]}</p></div>)}</div><div class="feature-article"><div><p class="eyebrow">{t.relatedGuide}</p><h2>{all[3].title}</h2><p>{all[3].description}</p><a class="button" href={path(lang,'articles/'+all[3].slug)}>{t.readArticle}<Icon size={17}/></a></div><Icon name="camera" size={100}/></div></section>}
{route==='shipping'&&<section class="container section"><div class="page-heading"><p class="eyebrow">{t.shippingEyebrow}</p><h1>{t.shippingTitle}</h1><p>{t.shippingIntro}</p></div><div class="shipping-tools"><a href="https://www.superbuy.com/en/page/query/freight/" target="_blank" rel="noopener"><Icon name="box" size={30}/><h2>{t.calculator}</h2><span>↗</span></a><a href="https://www.superbuy.com/en/page/query/package/" target="_blank" rel="noopener"><Icon name="search" size={30}/><h2>{t.tracking}</h2><span>↗</span></a></div><p class="caption">{t.shippingNote}</p><div class="section-heading shipping-reading"><div><p class="eyebrow">{t.journalEyebrow}</p><h2>{t.nextReading}</h2></div></div><div class="article-grid">{[4,5,6].map(i=><ArticleCard article={all[i]} index={i} lang={lang}/>)}</div></section>}
{route==='product'&&<section class="container section product-page"><a class="back-link" href={path(lang,'spreadsheet')}>← {t.backCatalog}</a><div id="product-detail" aria-live="polite"><div class="empty-state"><h1>{t.productImages}</h1><p>{t.loadingProduct}</p></div></div></section>}
</Layout>
