---
import Layout from '../layouts/Layout.astro';
import {localPath,getContent,availableLocales,origin} from '../lib/content.mjs';
export function getStaticPaths(){return availableLocales().flatMap(([lang])=>{const d=getContent(lang);return ['', 'spreadsheet','finds','qc','guide','shipping','faq','articles','product','image-search',...d.articles.map(a=>'articles/'+a.slug)].map(path=>({params:{route:[lang==='en'?'':lang,path].filter(Boolean).join('/')||undefined},props:{lang,path,data:d}}));});}
const {lang,path,data}=Astro.props;
const t=data.ui;
const article=path.startsWith('articles/')?data.articles.find(a=>path===`articles/${a.slug}`):null;
const page=data.pages[path];
const title=article?.title||page?.title||(path==='product'?t.productDetails:data.home.title+' '+data.home.titleAccent);
const description=article?.description||page?.intro||data.home.intro;
const articleLinks=(items)=>items;
const isCatalog=['spreadsheet','finds'].includes(path);
const wordCount=article?JSON.stringify([article.intro,article.sections]).split(/\s+/).length:0;
---
<Layout lang={lang} path={path} title={title} description={description} data={data}>
{path===''&&<>
 <section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="orange-line"></span>{data.home.eyebrow}</p><h1>{data.home.title}<br/><em>{data.home.titleAccent}</em></h1><p class="hero-intro">{data.home.intro}</p><form class="search-form" action={localPath(lang,'spreadsheet')}><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg><input name="q" placeholder={t.searchPlaceholder} aria-label={t.search} required/><button type="submit" aria-label={t.search}>↗</button></form><div class="hero-links"><a href={localPath(lang,'spreadsheet')}>{t.browseAll} <span>→</span></a><a class="subtle" href={localPath(lang,'guide')}>{t.readGuide}</a><a class="subtle" href={localPath(lang,'image-search')}>{t.imageSearch}</a></div></div><div class="hero-feature"><div class="feature-top"><span class="live-dot"></span>{data.home.featuredLabel}<span class="feature-number">01 /</span></div><div data-hero-product><!--hero-start--><div class="hero-loading"><div class="spinner"></div><span>{t.loading}</span></div><!--hero-end--></div><div class="feature-bottom">{data.home.heroNote}<span>↗</span></div></div></section>
 <section class="category-section wrap"><div class="section-heading"><div><p class="eyebrow">01 / {t.category}</p><h2>{data.home.categoryTitle}</h2></div></div><div class="category-grid">{Object.entries(data.categories).filter(([key])=>key!=='all').map(([key,label],i)=><a href={localPath(lang,'spreadsheet')+'?category='+key}><span class="category-num">{String(i+1).padStart(2,'0')}</span><span>{label}</span><span class="category-arrow">↗</span></a>)}</div></section>
 <section class="wrap section"><div class="section-heading"><div><p class="eyebrow">02 / {t.latest}</p><h2>{data.home.latestTitle}</h2><p>{data.home.latestIntro}</p></div><a class="text-link" href={localPath(lang,'spreadsheet')}>{t.viewAll} ↗</a></div><div class="product-grid home-products" data-catalog="home"><!--catalog-start--><div class="loading-box"><span class="spinner"></span>{t.loading}</div><!--catalog-end--></div></section>
 <section class="process"><div class="wrap process-inner"><div class="process-heading"><p class="eyebrow">03 / {t.guide}</p><h2>{data.home.workflowTitle}</h2><a class="text-link" href={localPath(lang,'guide')}>{t.readGuide} ↗</a></div><div class="steps">{data.home.steps.map((s,i)=><div><span class="step-number">0{i+1}</span><h3>{s.title}</h3><p>{s.text}</p></div>)}</div></div></section>
 <section class="wrap section journal"><div class="section-heading"><div><p class="eyebrow">04 / {t.articles}</p><h2>{data.home.journalTitle}</h2><p>{data.home.journalIntro}</p></div><a class="text-link" href={localPath(lang,'articles')}>{t.viewAll} ↗</a></div><div class="article-grid">{data.articles.slice(0,4).map((a,i)=><a class="article-card" href={localPath(lang,'articles/'+a.slug)}><div class="article-card-top"><span>{a.category}</span><span>0{i+1}</span></div><h3>{a.title}</h3><p>{a.description}</p><div class="article-card-bottom">{t.readGuide}<span>↗</span></div></a>)}</div></section>
 <section class="wrap home-faq"><div><p class="eyebrow">{t.faq}</p><h2>{data.pages.faq.title}</h2><a class="text-link" href={localPath(lang,'faq')}>{t.viewAll} →</a></div><div>{data.faq.slice(0,4).map(f=><details class="faq-item"><summary>{f.q}<span>+</span></summary><p>{f.a}</p></details>)}</div></section>
 </>}
{isCatalog&&<section class="wrap page-section"><div class="page-heading"><p class="eyebrow">{path==='finds'?t.latest:t.comparison}</p><h1>{page.title}</h1><p>{page.intro}</p></div><div class="catalog-layout"><aside class="category-sidebar"><p class="eyebrow">{t.category}</p><div>{Object.entries(data.categories).map(([id,label])=><a data-category={id} href={localPath(lang,path)+'?category='+id}>{label}<span>↗</span></a>)}</div><a class="sidebar-guide" href={localPath(lang,'guide')}><span>↗</span><strong>{t.readGuide}</strong><small>{data.home.steps[1].text}</small></a></aside><div class="catalog-main"><div class="catalog-toolbar"><form class="search-form compact" action={localPath(lang,path)}><input name="q" aria-label={t.search} placeholder={t.searchPlaceholder}/><button aria-label={t.search}>↗</button></form><label class="sort-label"><span>{t.sort}</span><select id="sort"><option value="latest">{t.latest}</option><option value="popular">{t.popular}</option><option value="price-asc">{t.priceLow}</option><option value="price-desc">{t.priceHigh}</option></select></label></div><div class="catalog-meta"><span data-result-count>{t.loading}</span><a data-clear href={localPath(lang,path)}>{t.clear} ×</a></div><div class="product-grid" data-catalog="full"><!--catalog-start--><div class="loading-box"><span class="spinner"></span>{t.loading}</div><!--catalog-end--></div><nav class="pagination" aria-label={t.page}><a data-prev href="#" aria-disabled="true">← {t.previous}</a><span>{t.page} <strong data-page>1</strong></span><a data-next href="#">{t.next} →</a><form data-jump><label>{t.jumpPage}<input type="number" min="1" max="10000" name="page" value="1" aria-label={t.page}/></label><button>{t.go}</button></form></nav><p class="fineprint">{t.priceNote}</p></div></div></section>}
{path==='product'&&<section class="wrap page-section"><a class="back-link" href={localPath(lang,'spreadsheet')}>← {t.backToCatalog}</a><div data-product-detail class="product-detail-shell"><!--product-start--><div class="loading-box"><span class="spinner"></span>{t.sourceLoading}</div><!--product-end--></div></section>}
{['qc','guide','shipping'].includes(path)&&<section class="wrap page-section editorial-page"><div class="page-heading"><p class="eyebrow">{t.verifiedSources}</p><h1>{page.title}</h1><p>{page.intro}</p></div><div class="editorial-layout"><aside class="editorial-aside"><span class="aside-label">USFANS / {t[path].toUpperCase()}</span><p>{data.home.steps[path==='qc'?1:path==='shipping'?2:0].text}</p><a class="button button-dark" href={localPath(lang,'spreadsheet')}>{t.browseAll} ↗</a></aside><div class="editorial-body">{page.sections.map((s,i)=><section><p class="section-number">0{i+1}</p><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}<div class="related-callout"><span>{t.related}</span><a href={localPath(lang,'articles/'+page.article)}>{data.articles.find(a=>a.slug===page.article)?.title||t.readGuide} ↗</a></div></div></div></section>}
{path==='faq'&&<section class="wrap page-section faq-page"><div class="page-heading"><p class="eyebrow">{t.verifiedSources}</p><h1>{page.title}</h1><p>{page.intro}</p></div><div class="faq-layout"><aside><span class="faq-big">{data.faq.length}</span><p>{t.faq}</p><input id="faq-search" type="search" placeholder={t.faqSearch} aria-label={t.faqSearch}/><a class="text-link" href={localPath(lang,'guide')}>{t.readGuide} ↗</a></aside><div class="faq-list">{data.faq.map((f,i)=><details class="faq-item" data-faq-item><summary><span class="faq-index">{String(i+1).padStart(2,'0')}</span>{f.q}<span>+</span></summary><div><p>{f.a}</p><a class="source-link" href={f.source} target="_blank" rel="noopener noreferrer">{t.officialSources}: {f.sourceTitle} ↗</a></div></details>)}<p id="faq-empty" hidden>{t.faqEmpty}</p></div></div></section>}
{path==='articles'&&<section class="wrap page-section"><div class="page-heading"><p class="eyebrow">USFANS / {t.articles}</p><h1>{page.title}</h1><p>{page.intro}</p></div><div class="article-grid article-library">{data.articles.map((a,i)=><a class="article-card" href={localPath(lang,'articles/'+a.slug)}><div class="article-card-top"><span>{a.category}</span><span>{String(i+1).padStart(2,'0')}</span></div><h2>{a.title}</h2><p>{a.description}</p><div class="article-card-bottom">{t.readGuide}<span>↗</span></div></a>)}</div></section>}
{article&&<article class="wrap page-section article-detail"><a class="back-link" href={localPath(lang,'articles')}>← {t.allArticles}</a><header class="article-header"><p class="eyebrow">{article.category} <span>/</span> {Math.ceil(wordCount/220)} {t.readTime}</p><h1>{article.title}</h1><p class="article-deck">{article.description}</p><div class="article-byline"><span>USFans Buys</span><span>{t.updated}</span></div></header><div class="article-layout"><aside class="toc"><p class="eyebrow">{t.contents}</p><ol>{article.sections.map((s,i)=><li><a href={'#section-'+i}>{s.heading}</a></li>)}</ol></aside><div class="article-body">{(Array.isArray(article.intro)?article.intro:[article.intro]).map(p=><p class="intro-paragraph">{p}</p>)}{article.sections.map((s,i)=><section id={'section-'+i}><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.bullets&&<ul>{s.bullets.map(b=><li>{b}</li>)}</ul>}</section>)}<div class="article-sources"><h2>{t.officialSources}</h2>{article.sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div><div class="related-callout"><span>{t.related}</span><a href={localPath(lang,'spreadsheet')}>{t.browseAll} ↗</a></div></div></div><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,inLanguage:lang,datePublished:'2026-10-26',dateModified:'2026-10-26',author:{'@type':'Organization',name:'USFans Buys'},mainEntityOfPage:origin+localPath(lang,path)})}/></article>}
{path==='image-search'&&<section class="wrap page-section editorial-page"><div class="page-heading"><p class="eyebrow">{t.imageSearch}</p><h1>{page.title}</h1><p>{page.intro}</p></div><div class="honest-notice"><span class="notice-icon">⌕</span><p>{t.imageUnavailable}</p><p>{t.imageAlternative}</p><form class="search-form" action={localPath(lang,'spreadsheet')}><input name="q" required placeholder={t.searchPlaceholder} aria-label={t.search}/><button aria-label={t.search}>↗</button></form></div></section>}
</Layout>
