---
import {localPath,origin,preview,locales,sections} from '../lib/content.mjs';
const {lang='en',path='',title,description,data}=Astro.props;
const t=data.ui;
const canonical=origin+localPath(lang,path);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title} | USFans Buys</title><meta name="description" content={description}/>
  <meta name="robots" content={preview?'noindex,nofollow':'index,follow'}/>
  <meta name="theme-color" content="#f5f3ef"/>
  <link rel="canonical" href={canonical}/>
  {locales.map(([code])=><link rel="alternate" hreflang={code} href={origin+localPath(code,path)}/>)}
  <link rel="alternate" hreflang="x-default" href={origin+localPath('en',path)}/>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <link rel="stylesheet" href="/style.css"/>
  <meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebSite',name:'USFans Buys',url:origin,inLanguage:lang,description})}/>
</head>
<body data-lang={lang} data-path={path}>
<a class="skip" href="#main">{t.contents}</a>
<header class="header">
 <div class="header-inner">
  <a class="brand" href={localPath(lang)} aria-label="USFans Buys"><img src="/logo.webp" alt="USFans" width="142" height="38"/><span>BUYS</span></a>
  <nav aria-label="Main" class="nav">{sections.map(key=><a href={localPath(lang,key)} aria-current={path===key||path.startsWith(key+'/')?'page':undefined}>{t[key]}</a>)}</nav>
  <div class="header-actions">
   <details class="language"><summary aria-label={t.language}><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18"/></svg><span>{lang.toUpperCase()}</span><span class="chevron">⌄</span></summary><div class="language-options">{locales.map(([code,name])=><a data-language={code} href={localPath(code,path)} lang={code} aria-current={code===lang?'true':undefined}>{name}<small>{code.toUpperCase()}</small></a>)}</div></details>
   <a class="button button-dark join" href="https://www.usfans.com/register" target="_blank" rel="noopener noreferrer">{t.register}<span>↗</span></a>
  </div>
 </div>
</header>
<main id="main"><slot/></main>
<footer class="footer"><div class="footer-top"><a class="brand" href={localPath(lang)}><img src="/logo.webp" alt="USFans" width="142" height="38"/><span>BUYS</span></a><p>{t.footerNote}</p><a href={localPath(lang,'spreadsheet')}>{t.browseAll} <span>↗</span></a></div><div class="footer-bottom"><p>{t.independent}<br/>{t.affiliate}</p><div>© 2026 USFans Buys {preview&&<><span>·</span> {t.preview}</>}</div></div></footer>
<script type="application/json" id="site-translations" set:html={JSON.stringify({ui:t,categories:data.categories}).replace(/</g,'\u003c')}/>
<script type="module" src="/app.js"></script>
</body></html>
