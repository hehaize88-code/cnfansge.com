{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sugargoos-shop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
